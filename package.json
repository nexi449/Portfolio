{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "cross-env PORTFOLIO_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "cross-env PORTFOLIO_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:upload": "cross-env PORTFOLIO_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare upload -- --keep-vars",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy -- --keep-vars"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wrangler": "4.168.0"
  }
}
