# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Keep the local ignore rules out of the GitHub repository.
/.gitignore

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/
/.wrangler/
/wrangler.jsonc

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment and secrets
.env.local
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# local agent instructions
AGENTS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
